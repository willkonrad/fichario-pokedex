      "refersTo": "binder-pocket",
      "description": "Bolso grafite com cápsula de preço em 11 px; destaque em amarelo-claro e anel de foco branco.",
      "html": "<div class=\"ds-page\"><button class=\"ds-pocket\" aria-label=\"Carta, valor R$ 41\"><span class=\"ds-pocket-art\"></span></button><span class=\"ds-price\">R$ 41</span></div>",
      "css": ".ds-page{display:inline-flex;flex-direction:column;gap:3px;width:104px;padding:10px;background:#1E2023;border:1px solid #33373C;border-radius:14px}.ds-pocket{display:block;width:104px;height:145px;box-sizing:border-box;padding:3px;border-radius:8px;border:1px solid #3D4147;background:#2A2D31;cursor:pointer}.ds-pocket:hover{border-color:#9399A5;transform:translateY(-2px)}.ds-pocket:active{opacity:.75}.ds-pocket:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}.ds-pocket-art{display:block;width:100%;height:100%;border-radius:4px;background:#1E2023}.ds-price{align-self:center;padding:1px 6px;border-radius:999px;background:rgba(255,255,255,.08);color:#E9EBF0;font:700 11px system-ui,sans-serif;font-variant-numeric:tabular-nums}"
    },
