      "html": "<div class=\"ds-card\"><h3 class=\"ds-card-title\">Valor da coleção</h3><p class=\"ds-card-value\">R$ 12.480</p></div>",
      "css": ".ds-card{background:#16181A;border-radius:20px;padding:16px;max-width:320px}.ds-card-title{font-family:Kanit,system-ui,sans-serif;font-style:italic;font-weight:700;font-size:18px;line-height:24px;letter-spacing:.5px;text-transform:uppercase;color:#FFF690;margin:0 0 4px}.ds-card-value{font:800 26px/32px system-ui,sans-serif;font-variant-numeric:tabular-nums;color:#FFFFFF;margin:0}"
    },
    {
      "name": "Base fixa da home",
      "kind": "nav",
      "refersTo": "add-card-pill",
      "description": "Paginação e pílula no celular, fundo preto opaco, 8 de vão entre alvos de 48.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Paginação\"><button class=\"ds-dock-round\" aria-label=\"Página anterior\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><button class=\"ds-dock-mid\">Pág. 1 <span>de 114</span></button><button class=\"ds-dock-round\" aria-label=\"Próxima página\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><button class=\"ds-dock-add\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg><span>Carta</span></button></nav>",
      "css": ".ds-dock{display:flex;align-items:center;gap:8px;padding:8px;background:#000000;border-top:1px solid #2E3236;max-width:390px}.ds-dock-round{width:48px;height:48px;border-radius:999px;background:#16181A;border:1.5px solid #2E3236;color:#FFFFFF;display:grid;place-items:center;cursor:pointer}.ds-dock-round:hover{background:#232629}.ds-dock-round:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}.ds-dock-mid{flex:1;height:48px;border:0;background:transparent;border-radius:14px;color:#FFFFFF;font:800 14px/18px system-ui,sans-serif;font-variant-numeric:tabular-nums;cursor:pointer}.ds-dock-mid span{color:#C4C9D0;font-weight:600}.ds-dock-mid:hover{background:rgba(255,255,255,.08)}.ds-dock-mid:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}.ds-dock-add{display:inline-flex;align-items:center;gap:4px;min-height:48px;padding:0 16px 0 12px;border:0;border-radius:999px;background:linear-gradient(180deg,#E6171E,#C40D13);color:#FFFFFF;font-family:Kanit,system-ui,sans-serif;font-style:italic;font-weight:700;font-size:15px;text-transform:uppercase;cursor:pointer}.ds-dock-add:hover{background:#C40D13}.ds-dock-add:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}"
    },
    {
      "name": "Bolso do fichário com preço",
