  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Pílula vermelha em gradiente, só na ação principal da tela.",
      "html": "<button class=\"ds-btn-primary\">Colocar no fichário</button>",
      "css": ".ds-btn-primary{min-height:50px;padding:0 20px;border-radius:999px;border:1.5px solid #E6171E;background:linear-gradient(180deg,#E6171E,#C40D13);color:#FFFFFF;font-family:Kanit,system-ui,sans-serif;font-style:italic;font-weight:700;font-size:16px;line-height:20px;letter-spacing:.5px;text-transform:uppercase;cursor:pointer}.ds-btn-primary:hover{background:#C40D13;border-color:#C40D13}.ds-btn-primary:active{transform:scale(.98);opacity:.9}.ds-btn-primary:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Contorno claro, para as ações que não são a principal.",
      "html": "<button class=\"ds-btn-secondary\">Ver versões</button>",
      "css": ".ds-btn-secondary{min-height:50px;padding:0 20px;border-radius:999px;border:1.5px solid #7E858F;background:transparent;color:#FFFFFF;font-family:Kanit,system-ui,sans-serif;font-style:italic;font-weight:700;font-size:16px;line-height:20px;letter-spacing:.5px;text-transform:uppercase;cursor:pointer}.ds-btn-secondary:hover{background:#232629}.ds-btn-secondary:active{transform:scale(.98);opacity:.9}.ds-btn-secondary:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}"
    },
    {
      "name": "Pílula + Carta",
      "kind": "button",
      "refersTo": "add-card-pill",
      "description": "Ação principal da home: base fixa no celular, barra do topo no computador.",
      "html": "<button class=\"ds-add-pill\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg><span>Carta</span></button>",
      "css": ".ds-add-pill{display:inline-flex;align-items:center;gap:4px;min-height:48px;padding:0 16px 0 12px;border:0;border-radius:999px;background:linear-gradient(180deg,#E6171E,#C40D13);color:#FFFFFF;font-family:Kanit,system-ui,sans-serif;font-style:italic;font-weight:700;font-size:15px;text-transform:uppercase;cursor:pointer}.ds-add-pill:hover{background:#C40D13}.ds-add-pill:active{opacity:.8}.ds-add-pill:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}"
    },
