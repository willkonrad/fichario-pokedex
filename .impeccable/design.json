      "css": ".ds-chip-row{display:flex;gap:8px}.ds-chip{min-height:48px;padding:0 14px;border-radius:999px;border:1.5px solid #2E3236;background:#232629;color:#FFFFFF;font:600 14px system-ui,sans-serif;cursor:pointer}.ds-chip:hover{border-color:#7E858F}.ds-chip-on,.ds-chip-on:hover{background:#FFFFFF;border-color:#FFFFFF;color:#000000}.ds-chip:focus-visible{outline:2px solid #FFFFFF;outline-offset:2px}"
    },
