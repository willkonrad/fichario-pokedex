{
  "expo": {
    "name": "Fichário Pokédex",
    "slug": "pokedex-binder",
    "version": "3.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pokedexbinder",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.willkonrad.fichariopokedex",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.willkonrad.fichariopokedex",
      "adaptiveIcon": {
        "backgroundColor": "#E6171E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "pt-BR",
      "description": "Seu fichário de cartas Pokémon TCG, bolso por bolso, com o valor em reais.",
      "themeColor": "#000000"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "./plugins/with-async-storage-size.js",
        {
          "sizeInMB": 50
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "gifEnabled": false,
            "webpEnabled": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "./plugins/with-camera-document-scanner.js",
        {
          "enabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7bb069df-1902-4427-a2ba-6c6f4ab9ea4c"
      }
    },
    "owner": "mistko",
    "updates": {
      "url": "https://u.expo.dev/7bb069df-1902-4427-a2ba-6c6f4ab9ea4c"
    }
  }
}
