{
  "expo": {
    "name": "Fichário Pokédex",
    "slug": "pokedex-binder",
    "version": "3.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pokedexbinder",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.willkonrad.fichariopokedex",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.willkonrad.fichariopokedex",
      "adaptiveIcon": {
        "backgroundColor": "#E3350D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "pt-BR",
      "description": "Seu fichário de cartas Pokémon TCG, bolso por bolso, com o valor em reais.",
      "themeColor": "#E3350D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3350D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
